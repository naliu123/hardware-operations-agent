# Install as /etc/hwops/hwops.env with mode 0600.
HWOPS_AUTH_MODE=users
HWOPS_LISTEN_ADDR=127.0.0.1:8080
HWOPS_PUBLIC_ORIGIN=https://hwops.example.internal
HWOPS_WEB_DIR=/opt/hwops/web/dist

HWOPS_DATABASE_URL=postgres://hwops_app:replace-me@postgres.internal:5432/hwops?sslmode=verify-full
HWOPS_FILES_DIR=/var/lib/hwops/files
HWOPS_FILE_QUOTA_BYTES=10000000000
HWOPS_FILE_RESERVE_BYTES=1000000000

HWOPS_MODEL_MODE=LIVE
HWOPS_MODEL_ENDPOINT=https://model-gateway.example.internal/v1/chat/completions
HWOPS_MODEL=replace-with-approved-model
HWOPS_MODEL_API_KEY=replace-with-deployment-secret
HWOPS_MODEL_CONTEXT_TOKENS=131072
HWOPS_INPUT_TOKEN_BUDGET=98304

HWOPS_RUNNER_URL=https://runner.example.internal:8091
HWOPS_RUNNER_TOKEN_FILE=/etc/hwops/runner-token
HWOPS_PARSER_RUNNER_URL=https://runner.example.internal:8092
HWOPS_PARSER_RUNNER_TOKEN_FILE=/etc/hwops/parser-runner-token

HWOPS_TRACE_PRIVATE_CONTENT=false
HWOPS_EVIDENCE_SELECTION=false
HWOPS_QUERY_REWRITE=false
