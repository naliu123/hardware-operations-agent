hwops.example.internal {
	tls /etc/hwops/tls/fullchain.pem /etc/hwops/tls/private.key

	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		-Server
	}
}
